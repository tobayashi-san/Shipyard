{
  "name": "shipyard",
  "version": "2.0.4",
  "description": "Modern Linux Server Management Dashboard",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "cd server && node --watch index.js",
    "dev:frontend": "cd frontend-next && npm run dev",
    "start": "cd server && NODE_ENV=production node index.js",
    "test": "npm run test:server && npm run test:frontend",
    "test:server": "npm --prefix server test",
    "test:frontend": "npm --prefix frontend-next test",
    "build": "npm --prefix frontend-next run build",
    "typecheck": "npm --prefix frontend-next run typecheck",
    "lint": "npm --prefix frontend-next run lint",
    "audit": "npm --prefix server audit --omit=dev && npm --prefix frontend-next audit --omit=dev",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
