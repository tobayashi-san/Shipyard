# Copy this file to .env, generate new secrets, then restrict its permissions:
#   cp .env.example .env && chmod 600 .env
#   sed -i "s/^JWT_SECRET=$/JWT_SECRET=$(openssl rand -hex 32)/" .env
#   sed -i "s/^SHIPYARD_KEY_SECRET=$/SHIPYARD_KEY_SECRET=$(openssl rand -hex 32)/" .env

# Pin a release (recommended for production), e.g.
# SHIPYARD_IMAGE=ghcr.io/tobayashi-san/shipyard:1.2.3
SHIPYARD_IMAGE=ghcr.io/tobayashi-san/shipyard:latest

# Compose binds to localhost by default. Change only to a private-LAN address
# when access is protected by a firewall or VPN.
SHIPYARD_BIND_ADDRESS=127.0.0.1
SHIPYARD_PORT=443

TZ=Europe/Zurich
SHIPYARD_TIMEZONE=Europe/Zurich

# Optional: only set these for the appropriate deployment topology.
# CERT_SANS=IP:10.20.1.10,DNS:shipyard.example.internal
# ALLOWED_ORIGINS=https://shipyard.example.internal
# TRUST_PROXY=1

# Required. Never commit or share these values. Keep SHIPYARD_KEY_SECRET stable:
# changing it prevents decrypting stored keys and other encrypted settings.
JWT_SECRET=
SHIPYARD_KEY_SECRET=
